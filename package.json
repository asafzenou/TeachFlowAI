{
  "name": "teach-me-this-file",
  "version": "0.1.0",
  "description": "A grounded AI lesson workspace built with React, Vite, and Vercel Functions.",
  "private": true,
  "engines": {
    "node": ">= 24.x",
    "npm": ">= 11.x"
  },
  "packageManager": "npm@11.17.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch backend/local.js",
    "dev:client": "vite",
    "format": "oxfmt frontend api backend vite.config.js",
    "format:check": "oxfmt --check frontend api backend vite.config.js",
    "lint": "oxlint .",
    "prebuild": "npm run clean",
    "preview": "vite preview",
    "test": "node --test backend/**/*.test.js frontend/src/**/*.test.js",
    "check": "npm run format:check && npm run lint"
  },
  "keywords": ["ai", "education", "react", "vercel"],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "dotenv": "18.0.8",
    "express": "^5.3.0",
    "lucide-react": "1.59.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^10.0.6",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "supertest": "^7.3.1",
    "tailwindcss": "4.3.3",
    "vercel": "64.5.0",
    "vite": "8.3.4"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "@tootallnate/once": "^3.0.1",
    "ajv": "^8.20.0",
    "brace-expansion": "^5.0.12",
    "glob": "^13.0.6",
    "js-yaml": "^5.4.2",
    "minimatch": "^10.2.6",
    "path-to-regexp": "^8.4.2",
    "smol-toml": "^1.7.1",
    "tar": "^7.5.22",
    "undici": "^8.11.2"
  },
  "volta": {
    "node": "24.18.1",
    "npm": "12.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
